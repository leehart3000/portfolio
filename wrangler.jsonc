{
	"compatibility_date": "2026-06-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "portfolio",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "CONTACT_SUBMISSIONS",
			"id": "2b70c51d578a4d30be1e69d62e5be17c"
		},
		{
			"binding": "SESSION",
			"id": "48872dc59e1d478fb0eda3ce928c5594"
		}
	],
	"secrets": {
		"required": ["RESEND_API_KEY"]
	}
}