---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const creations = allProjects.filter((p) => p.data.kind === 'creation');
const contributions = allProjects.filter((p) => p.data.kind === 'contribution');
---

<BaseLayout title="Lee Hart - Projects">
  <h1>Recent creations</h1>
  <p>
    A selection of what I'm currently building — from live, working
    platforms through to early-stage experiments. Each entry links
    through to its live site or repository where available, along
    with the technologies involved.
  </p>
  {creations.map((project) => <ProjectCard project={project} linkTitle={true} />)}

  {contributions.length > 0 && (
    <section id="other-projects">
      <h2>Other projects</h2>
      <p>
        Established projects that I've contributed to as part of a team.
      </p>
      {contributions.map((project) => <ProjectCard project={project} linkTitle={true} />)}
    </section>
  )}
</BaseLayout>

<style>
  #other-projects {
    margin-top: 2.5em;
    scroll-margin-top: 1em;
  }
</style>
