---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';

const homeButtons = [
  { href: '/projects', icon: '📁', label: 'Projects', color: '#D0E8F5' },
  { href: '/tech', icon: '🛠️', label: 'Technologies', color: '#E4D9F2' },
  { href: '/employments', icon: '💼', label: 'Employments', color: '#D9E9D9' },
  { href: '/certificates', icon: '📚', label: 'Certificates', color: '#FCEFC7' },
  { href: '/contact', icon: '✉️', label: 'Contact', color: '#F5D9E0' },
  { href: '/docs/Lee_Hart_public_CV_Sep2026.pdf', icon: '📄', label: 'CV / Résumé', color: '#E0E0E0' },
];
---

<BaseLayout title="Lee Hart - Software Development">
	<h1>Lee Hart - Experienced Software Developer</h1>
	<span class="headshot-frame">
		<Image
			src={headshot}
			alt="Photo of Lee Hart"
			width={140}
			densities={[1, 2]}
			format="webp"
			quality={80}
			class="headshot"
		/>
	</span>
	<p>
		I'm an experienced software developer working across web platforms, data-driven
		applications, and scientific tooling. I build things end-to-end —
		from backend architecture and APIs through to clean, usable
		frontends — with a particular interest in projects that combine
		software engineering with data, science, or education.
	</p>
	<p>
		This site is a running record of what I'm building, from active
		client and personal projects through to early-stage experiments.
		Take a look at my <a href="/projects">recent projects</a> to see
		what I've been working on.
	</p>

	<nav class="home-buttons">
		{homeButtons.map((b) => (
			<a href={b.href} class="home-button" style={`--badge-color: ${b.color}`}>
				<span class="home-button-icon">{b.icon}</span>
				<span>{b.label}</span>
			</a>
		))}
	</nav>
</BaseLayout>

<style>
	.headshot-frame {
		display: block;
		float: right;
		border-radius: 8px;
		border: 1px solid var(--color-image-border);
		margin-top: 0.3em;
		margin-left: 1.5em;
		margin-bottom: 1em;
		overflow: hidden;
		line-height: 0;
	}
	.headshot {
		display: block;
	}
	@media (max-width: 480px) {
		.headshot-frame {
			float: none;
			margin: 0 auto 1.5em;
			width: fit-content;
		}
	}

	.home-buttons {
		display: flex;
		justify-content: space-between;
		gap: 0.8em;
		margin-top: 2em;
		clear: both;
		flex-wrap: wrap;
	}
	.home-button {
		position: relative;
		isolation: isolate;
		flex: 1 1 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4em;
		padding: 1em 0.5em;
		text-align: center;
		border-radius: 8px;
		text-decoration: none;
		color: #333;
		white-space: nowrap;
	}
	.home-button::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background-color: var(--badge-color);
		z-index: -1;
	}
	:root[data-theme="dark"] .home-button::before {
		filter: brightness(0.75) saturate(0.9);
	}
	:root[data-theme="dark"] .home-button {
		color: #333;
	}
	.home-button:hover {
		text-decoration: none;
		filter: brightness(0.95);
	}
	:root[data-theme="dark"] .home-button:hover::before {
		filter: brightness(0.85) saturate(0.9);
	}
	.home-button-icon {
		font-size: 1.6em;
	}
	@media (max-width: 480px) {
		.home-button {
			flex: 1 1 45%;
		}
	}
</style>