---
import { getCollection, render } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const hasBody = (project.body ?? '').trim().length > 0;
---

<BaseLayout title={`Lee Hart - ${project.data.title}`}>
  <Breadcrumb parentLabel="Projects" parentHref="/projects" current={project.data.title} />
  <ProjectCard project={project} />
  {hasBody && (
    <>
      <h2 class="detail-heading">More about this project</h2>
      <Content />
    </>
  )}
</BaseLayout>

<style>
  .detail-heading {
    font-size: 1.1em;
  }
</style>