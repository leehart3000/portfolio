---
import { getCollection, getEntry } from 'astro:content';
import { slugify } from '../../lib/slugify';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { techColors, defaultTechColor } from '../../data/tech-colors';
import { techCategoryColors } from '../../data/tech-category-colors';
import { techCategoryEmojis, defaultTechCategoryEmoji } from '../../data/tech-category-emojis';

const allProjects = await getCollection('projects');
const allEmployments = await getCollection('employments');
const allCertificates = await getCollection('certificates');

const techNames = new Set<string>();
allProjects.forEach((p) => p.data.tech.forEach((t) => techNames.add(t)));
allEmployments.forEach((e) => e.data.tech.forEach((t) => techNames.add(t)));
allCertificates.forEach((c) => c.data.tech.forEach((t) => techNames.add(t)));

const sortedTechNames = Array.from(techNames).sort((a, b) => a.localeCompare(b));

const techListWithMeta = await Promise.all(
  sortedTechNames.map(async (name) => {
    const entry = await getEntry('tech', slugify(name));
    return {
      name,
      slug: slugify(name),
      description: entry?.data.description ?? null,
      featured: entry?.data.featured ?? false,
      emoji: entry?.data.category ? (techCategoryEmojis[entry.data.category] ?? defaultTechCategoryEmoji) : defaultTechCategoryEmoji,
      borderColor: techColors[name] ?? (entry?.data.category ? techCategoryColors[entry.data.category] : null) ?? defaultTechColor,
      hasProjects: allProjects.some((p) => p.data.tech.includes(name)),
      hasEmployments: allEmployments.some((e) => e.data.tech.includes(name)),
      hasCertificates: allCertificates.some((c) => c.data.tech.includes(name)),
    };
  })
);

const favouriteTech = techListWithMeta
  .filter((t) => t.featured)
  .sort((a, b) => a.name.localeCompare(b.name));
const otherTech = techListWithMeta
  .filter((t) => !t.featured)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="Lee Hart - Tech">
  {favouriteTech.length > 0 && (
    <>
      <h2>Featured Technologies</h2>
      {favouriteTech.map((t) => (
        <article class="tech-entry" style={`border: 2px solid ${t.borderColor}`}>
          <div class="tech-entry-header">
            <h3 class="tech-entry-name">
              <a href={`/tech/${t.slug}`}><span class="tech-emoji">{t.emoji}&nbsp;</span>{t.name}</a>
            </h3>
            <a href={`/tech/${t.slug}`} class="more-info-link">
              <span class="info-icon">i</span>
              <span class="more-info-text">More about this tech</span>
            </a>
            <span class="tech-entry-links">
              {t.hasProjects && <a href={`/tech/${t.slug}#projects`} class="cross-link" style="--badge-color: #D0E8F5">📁&nbsp;Projects</a>}
              {t.hasEmployments && <a href={`/tech/${t.slug}#employments`} class="cross-link" style="--badge-color: #E4D9F2">💼&nbsp;Employments</a>}
              {t.hasCertificates && <a href={`/tech/${t.slug}#certificates`} class="cross-link" style="--badge-color: #FCEFC7">📚&nbsp;Certificates</a>}
            </span>
          </div>
          {t.description && <p>{t.description}</p>}
        </article>
      ))}
    </>
  )}

  <h2>Other Known Tech</h2>
  {otherTech.map((t) => (
    <article class="tech-entry">
      <div class="tech-entry-header">
        <h3 class="tech-entry-name">
          <a href={`/tech/${t.slug}`}><span class="tech-emoji">{t.emoji}&nbsp;</span>{t.name}</a>
        </h3>
        <a href={`/tech/${t.slug}`} class="more-info-link">
          <span class="info-icon">i</span>
          <span class="more-info-text">More about this tech</span>
        </a>
        <span class="tech-entry-links">
          {t.hasProjects && <a href={`/tech/${t.slug}#projects`} class="cross-link" style="--badge-color: #D0E8F5">📁&nbsp;Projects</a>}
          {t.hasEmployments && <a href={`/tech/${t.slug}#employments`} class="cross-link" style="--badge-color: #E4D9F2">💼&nbsp;Employments</a>}
          {t.hasCertificates && <a href={`/tech/${t.slug}#certificates`} class="cross-link" style="--badge-color: #FCEFC7">📚&nbsp;Certificates</a>}
        </span>
      </div>
      {t.description && <p>{t.description}</p>}
    </article>
  ))}
</BaseLayout>

<style>
  .tech-entry {
    background: var(--color-bg-header);
    border-radius: 8px;
    padding: 1em 1.2em;
    margin-bottom: 1.2em;
  }
  .tech-entry-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1em;
  }
  .tech-entry-name {
    grid-column: 1;
    justify-self: start;
    margin: 0;
  }
  .more-info-link {
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.85em;
    white-space: nowrap;
  }
  .more-info-link:hover .more-info-text {
    text-decoration: underline;
  }
  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.3em;
    height: 1.3em;
    border-radius: 50%;
    background: var(--color-dev);
    color: white;
    font-size: 0.8em;
    font-family: Georgia, serif;
  }
  :root[data-theme="dark"] .info-icon {
    color: #14181d;
  }
  .tech-entry-links {
    grid-column: 3;
    justify-self: end;
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
  }
  .tech-emoji {
    text-decoration: none;
    display: inline-block;
  }
  .tech-entry-name a:hover .tech-emoji {
    text-decoration: none;
  }
  .cross-link {
    position: relative;
    isolation: isolate;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    color: #333;
    text-decoration: none;
    white-space: nowrap;
  }
  .cross-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--badge-color);
    z-index: -1;
  }
  :root[data-theme="dark"] .cross-link::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .cross-link {
    color: var(--color-bg);
  }
  .cross-link:hover {
    text-decoration: none;
    filter: brightness(0.95);
  }
  :root[data-theme="dark"] .cross-link:hover {
    filter: brightness(1.15);
  }
</style>