---
import { getCollection, render } from 'astro:content';
import EmploymentCard from '../../components/EmploymentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allEmployments = await getCollection('employments');
  return allEmployments.map((employment) => ({
    params: { id: employment.id },
    props: { employment },
  }));
}

const { employment } = Astro.props;
const { Content } = await render(employment);
---

<BaseLayout title={`Lee Hart - ${employment.data.name}`}>
  <p class="back-link"><span class="more-arrow">←</span>&nbsp;<a href="/employments">Recent employments</a></p>
  <EmploymentCard employment={employment} />
  <h2 class="detail-heading">More about this role</h2>
  <Content />
</BaseLayout>

<style>
  .detail-heading {
    font-size: 1.1em;
  }
  .more-arrow {
    text-decoration: none;
  }
</style>