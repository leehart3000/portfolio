---
import { techColors, defaultTechColor } from '../data/tech-colors';
import { slugify } from '../lib/slugify';
import Carousel from './Carousel.astro';
import { statusMeta } from '../data/status-meta';

interface Props {
  project: any;
  linkTitle?: boolean;
}

const { project, linkTitle = false } = Astro.props;
const detailHref = `/projects/${project.id}`;
---

<article>
  <div class="project-header">
    <div class="project-title-line">
      {project.data.logo && (
        <img class="project-logo" src={project.data.logo} alt="" />
      )}
      <h3>
        {linkTitle ? (
          <a href={detailHref}>{project.data.title}</a>
        ) : (
          project.data.title
        )}
      </h3>
    </div>
    {linkTitle && (
      <a href={detailHref} class="more-info-link">
        <span class="info-icon">i</span>
        <span class="more-info-text">more about this project</span>
      </a>
    )}
    <a href={`/project-statuses/${project.data.status}`} class="status-badge" style={`--badge-color: ${statusMeta[project.data.status].color}`}>
      Status: {statusMeta[project.data.status].label} {statusMeta[project.data.status].emoji}
    </a>
  </div>

  <p>{project.data.summary}</p>

  {linkTitle && project.data.screenshots && project.data.screenshots.length > 0 && (
    <div class="thumbnail-group">
      {project.data.screenshots.map((src: string, i: number) => (
        <img
          src={src}
          alt={`${project.data.title} screenshot ${i + 1}`}
          title="Click to enlarge"
          class="thumbnail-item"
        />
      ))}
      <div class="lightbox-overlay">
        <button class="lightbox-close" aria-label="Close">&times;</button>
        <img class="lightbox-image" src="" alt="" />
      </div>
    </div>
  )}

  {!linkTitle && project.data.screenshots && project.data.screenshots.length > 0 && (
    <Carousel images={project.data.screenshots} alt={project.data.title} />
  )}

  <p class="links-line">
    {linkTitle && (
      <>→&nbsp;<a href={detailHref}>Learn more about {project.data.title}</a><br /></>
    )}
    {project.data.liveUrl && (
      <>🔗&nbsp;Live site: <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer">{project.data.liveUrl}</a><br /></>
    )}
    {!project.data.liveUrl && project.data.demoUrl && (
      <>🧪&nbsp;Demo site: <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer">{project.data.demoUrl}</a><br /></>
    )}
    {project.data.repoUrl && (
      project.data.repoIsPrivate ? (
        <>🔒&nbsp;Private repo: <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">{project.data.repoUrl}</a></>
      ) : (
        <>📂&nbsp;Public repo: <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">{project.data.repoUrl}</a></>
      )
    )}
  </p>

  <fieldset class="tech-fieldset">
    <legend>Applied tech:</legend>
    {[...project.data.tech].sort((a, b) => a.localeCompare(b)).map((t: string) => (
      <a href={`/tech/${slugify(t)}`} class="tech-badge" style={`--badge-color: ${techColors[t] ?? defaultTechColor}`}>
        {t}
      </a>
    ))}
  </fieldset>

</article>

<style>
  article {
    padding-bottom: 1.5em;
    margin-bottom: 1.5em;
    border-bottom: 1px solid var(--color-border);
  }

  .project-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1em;
    margin-bottom: 0.2em;
  }
  .project-header + p {
    margin-top: 0;
  }
  .project-title-line {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .more-info-link {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.85em;
    white-space: nowrap;
  }
  .more-info-link:hover .more-info-text {
    text-decoration: underline;
  }
  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.3em;
    height: 1.3em;
    border-radius: 50%;
    background: var(--color-dev);
    color: white;
    font-size: 0.8em;
    font-family: Georgia, serif;
  }
  :root[data-theme="dark"] .info-icon {
    color: #14181d;
  }
  .project-logo {
    width: 1.4em;
    height: 1.4em;
    object-fit: contain;
  }
  .status-badge {
    justify-self: end;
    position: relative;
    isolation: isolate;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    color: #333;
    white-space: nowrap;
    text-decoration: none;
  }
  .status-badge:hover {
    text-decoration: none;
    filter: brightness(0.95);
  }
  .status-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--badge-color);
    z-index: -1;
  }
  :root[data-theme="dark"] .status-badge:hover {
    filter: brightness(1.15);
  }
  :root[data-theme="dark"] .status-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .status-badge {
    color: var(--color-bg);
  }
  .tech-badge {
    position: relative;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    margin: 0.15em;
    border-radius: 999px;
    color: #333;
    text-decoration: none;
    isolation: isolate;
  }
  .tech-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--badge-color);
    z-index: -1;
  }
  :root[data-theme="dark"] .tech-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .tech-badge {
    color: var(--color-bg);
  }
  .tech-fieldset {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.5em 0.8em;
    margin: 0.5em 0;
  }
  .tech-fieldset legend {
    padding: 0 0.4em;
    font-size: 0.85em;
    color: var(--color-text);
  }
  .links-line {
    line-height: 1.8;
  }
  .thumbnail {
    display: block;
    width: 200px;
    max-width: 100%;
    border-radius: 6px;
    margin: 0.5em 0;
  }
  .thumbnail-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin: 0.5em 0;
  }
  .thumbnail-item {
    width: 120px;
    max-width: 100%;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }
  .thumbnail-item:hover {
    opacity: 0.8;
  }
  .lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  .lightbox-overlay.open {
    display: flex;
  }
  .lightbox-image {
    max-width: 90vw;
    max-height: 85vh;
    border-radius: 6px;
  }
  .lightbox-close {
    position: absolute;
    top: 1em;
    right: 1.2em;
    background: none;
    border: none;
    color: white;
    font-size: 2em;
    line-height: 1;
    cursor: pointer;
  }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.thumbnail-group').forEach((group) => {
    const overlay = group.querySelector<HTMLElement>('.lightbox-overlay');
    const overlayImage = group.querySelector<HTMLImageElement>('.lightbox-image');
    const closeBtn = group.querySelector<HTMLElement>('.lightbox-close');

    function open(src: string, alt: string) {
      if (!overlay || !overlayImage) return;
      overlayImage.src = src;
      overlayImage.alt = alt;
      overlay.classList.add('open');
    }
    function close() {
      overlay?.classList.remove('open');
    }

    group.querySelectorAll<HTMLImageElement>('.thumbnail-item').forEach((thumb) => {
      thumb.addEventListener('click', () => open(thumb.src, thumb.alt));
    });
    closeBtn?.addEventListener('click', close);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  });
</script>