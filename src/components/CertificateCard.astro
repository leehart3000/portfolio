---
import { techColors, defaultTechColor } from '../data/tech-colors';
import { slugify } from '../lib/slugify';
import { getEntry } from 'astro:content';
import { getTechCategoryMap } from '../lib/tech-categories';
import { techCategoryColors } from '../data/tech-category-colors';

interface Props {
  certificate: any;
}

const { certificate } = Astro.props;

const dateStr = certificate.data.completionDate.toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});

const relatedWithExistence = certificate.data.relatedCertificates
  ? await Promise.all(
      certificate.data.relatedCertificates.map(async (rel: { name: string; slug: string }) => ({
        ...rel,
        exists: !!(await getEntry('certificates', rel.slug)),
      }))
    )
  : [];

const techCategoryMap = await getTechCategoryMap();
function resolveTechColor(t: string): string {
  if (techColors[t]) return techColors[t];
  const category = techCategoryMap[t];
  return category ? (techCategoryColors[category] ?? defaultTechColor) : defaultTechColor;
}
---

<article id={certificate.id}>
  <div class="certificate-header">
    <div class="certificate-name">
      {certificate.data.logo && (
        <img class="certificate-logo" src={certificate.data.logo} alt="" />
      )}
      <h3>{certificate.data.name}</h3>
    </div>
    <div class="certificate-meta">
      <span class="certificate-type">
        {certificate.data.type}{certificate.data.duration && ` (${certificate.data.duration})`}
      </span>
      <span class="certificate-date">Completed {dateStr}</span>
    </div>
  </div>

  {certificate.data.status && (
    <p class="status-row">
      <span class="certificate-status-badge">
        Status: {certificate.data.status.label} {certificate.data.status.emoji}
      </span>
    </p>
  )}

  <p class="provider-line">
    📚&nbsp;Provider: {certificate.data.providerUrl ? (
      <a href={certificate.data.providerUrl} target="_blank" rel="noopener noreferrer">{certificate.data.provider}</a>
    ) : (
      certificate.data.provider
    )}
  </p>

  <p>{certificate.data.summary}</p>

  {relatedWithExistence.length > 0 && (
    <p class="related-line">
      Included certificates:{' '}
      {relatedWithExistence.map((rel, i) => (
        <>{rel.exists ? <a href={`#${rel.slug}`}>{rel.name}</a> : <span>{rel.name}</span>}{i < relatedWithExistence.length - 1 && ', '}</>
      ))}
    </p>
  )}

  {certificate.data.url && (
    <p class="links-line">
      📜&nbsp;Certificate: <a href={certificate.data.url} target="_blank" rel="noopener noreferrer">{certificate.data.url}</a>
    </p>
  )}

  {certificate.data.tech.length > 0 && (
    <fieldset class="tech-fieldset">
      <legend>Applied tech:</legend>
      {[...certificate.data.tech].sort((a: string, b: string) => a.localeCompare(b)).map((t: string) => (
        <a href={`/tech/${slugify(t)}`} class="tech-badge" style={`--badge-color: ${resolveTechColor(t)}`}>
          {t}
        </a>
      ))}
    </fieldset>
  )}
</article>

<style>
  article {
    background: var(--color-bg-header);
    border-radius: 8px;
    padding: 1em 1.2em;
    margin-bottom: 1.2em;
  }
  .certificate-name {
    grid-column: 1;
    justify-self: start;
    margin: 0;
  }
  .certificate-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1em;
    margin-bottom: 0.2em;
  }
  .certificate-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    text-align: right;
  }
  .certificate-type,
  .certificate-date {
    font-size: 0.85em;
    color: var(--color-text);
    white-space: nowrap;
  }
  .status-row {
    margin: 0.2em 0;
    text-align: right;
  }
  .provider-line {
    margin-top: 0;
    font-size: 0.9em;
    color: var(--color-text);
  }
  .related-line {
    font-size: 0.9em;
  }
  .certificate-status-badge {
    position: relative;
    isolation: isolate;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    color: #333;
    white-space: nowrap;
  }
  .certificate-status-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: #D6E8F5;
    z-index: -1;
  }
  :root[data-theme="dark"] .certificate-status-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .certificate-status-badge {
    color: var(--color-bg);
  }
  .links-line {
    line-height: 1.8;
  }
  .tech-badge {
    position: relative;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    margin: 0.15em;
    border-radius: 999px;
    color: #333;
    text-decoration: none;
    isolation: isolate;
  }
  .tech-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--badge-color);
    z-index: -1;
  }
  :root[data-theme="dark"] .tech-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .tech-badge {
    color: var(--color-bg);
  }
  .tech-fieldset {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.5em 0.8em;
    margin: 0.5em 0;
  }
  .tech-fieldset legend {
    padding: 0 0.4em;
    font-size: 0.85em;
    color: var(--color-text);
  }
  .tech-badge:hover {
    filter: brightness(0.95);
  }
  :root[data-theme="dark"] .tech-badge:hover {
    filter: brightness(1.15);
  }
</style>