---
import { techColors, defaultTechColor } from '../data/tech-colors';
import { slugify } from '../lib/slugify';

interface Props {
  certificate: any;
}

const { certificate } = Astro.props;
---

<article id={certificate.id}>
  <div class="certificate-header">
    <h3 class="certificate-name">{certificate.data.name}</h3>
    <span class="certificate-type">
      {certificate.data.type}{certificate.data.duration && ` (${certificate.data.duration})`}
    </span>
    <span class="certificate-date">Completed {certificate.data.completionDate}</span>
  </div>

  {certificate.data.status && (
    <p class="status-row">
      <span class="certificate-status-badge">
        Status: {certificate.data.status.label} {certificate.data.status.emoji}
      </span>
    </p>
  )}

  <p class="provider-line">
    📚&nbsp;Provider: {certificate.data.providerUrl ? (
      <a href={certificate.data.providerUrl} target="_blank" rel="noopener noreferrer">{certificate.data.provider}</a>
    ) : (
      certificate.data.provider
    )}
  </p>

  <p>{certificate.data.summary}</p>

  {certificate.data.relatedCertificates && certificate.data.relatedCertificates.length > 0 && (
    <p class="related-line">
      Includes:{' '}
      {certificate.data.relatedCertificates.map((rel: { name: string; slug: string }, i: number) => (
        <>
          <a href={`#${rel.slug}`}>{rel.name}</a>
          {i < certificate.data.relatedCertificates.length - 1 && ', '}
        </>
      ))}
    </p>
  )}

  {certificate.data.url && (
    <p class="links-line">
      🔗&nbsp;Certificate: <a href={certificate.data.url} target="_blank" rel="noopener noreferrer">{certificate.data.url}</a>
    </p>
  )}

  {certificate.data.tech.length > 0 && (
    <fieldset class="tech-fieldset">
      <legend>Applied tech:</legend>
      {[...certificate.data.tech].sort((a: string, b: string) => a.localeCompare(b)).map((t: string) => (
        <a href={`/tech/${slugify(t)}`} class="tech-badge" style={`--badge-color: ${techColors[t] ?? defaultTechColor}`}>
          {t}
        </a>
      ))}
    </fieldset>
  )}
</article>

<style>
  article {
    background: var(--color-bg-header);
    border-radius: 8px;
    padding: 1em 1.2em;
    margin-bottom: 1.2em;
  }
  .certificate-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 1em;
    margin-bottom: 0.2em;
  }
  .certificate-name {
    grid-column: 1;
    justify-self: start;
    margin: 0;
  }
  .certificate-type {
    grid-column: 2;
    justify-self: center;
    font-size: 0.85em;
    color: var(--color-text);
    white-space: nowrap;
  }
  .certificate-date {
    grid-column: 3;
    justify-self: end;
    font-size: 0.85em;
    color: var(--color-text);
    white-space: nowrap;
  }
  .status-row {
    margin: 0.2em 0;
    text-align: right;
  }
  .provider-line {
    margin-top: 0;
    font-size: 0.9em;
    color: var(--color-text);
  }
  .related-line {
    font-size: 0.9em;
  }
  .certificate-status-badge {
    position: relative;
    isolation: isolate;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    color: #333;
    white-space: nowrap;
  }
  .certificate-status-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: #D6E8F5;
    z-index: -1;
  }
  :root[data-theme="dark"] .certificate-status-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .certificate-status-badge {
    color: var(--color-bg);
  }
  .links-line {
    line-height: 1.8;
  }
  .tech-badge {
    position: relative;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    margin: 0.15em;
    border-radius: 999px;
    color: #333;
    text-decoration: none;
    isolation: isolate;
  }
  .tech-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--badge-color);
    z-index: -1;
  }
  :root[data-theme="dark"] .tech-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .tech-badge {
    color: var(--color-bg);
  }
  .tech-fieldset {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.5em 0.8em;
    margin: 0.5em 0;
  }
  .tech-fieldset legend {
    padding: 0 0.4em;
    font-size: 0.85em;
    color: var(--color-text);
  }
  .tech-badge:hover {
    filter: brightness(0.95);
  }
  :root[data-theme="dark"] .tech-badge:hover {
    filter: brightness(1.15);
  }
</style>