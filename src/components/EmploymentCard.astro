---
import { techColors, defaultTechColor } from '../data/tech-colors';
import { slugify } from '../lib/slugify';
import { getTechCategoryMap } from '../lib/tech-categories';
import { techCategoryColors } from '../data/tech-category-colors';

interface Props {
  employment: any;
  linkTitle?: boolean;
}

const { employment, linkTitle = false } = Astro.props;
const detailHref = `/employments/${employment.id}`;
const hasBody = (employment.body ?? '').trim().length > 0;

const techCategoryMap = await getTechCategoryMap();
function resolveTechColor(t: string): string {
  if (techColors[t]) return techColors[t];
  const category = techCategoryMap[t];
  return category ? (techCategoryColors[category] ?? defaultTechColor) : defaultTechColor;
}
---

<article>
  <div class="employer-header">
    <div class="employer-title-line">
      {employment.data.logo && (
        <img class="employer-logo" src={employment.data.logo} alt="" />
      )}
      <h3>
        {linkTitle ? (
          <a href={detailHref}>{employment.data.name}</a>
        ) : (
          employment.data.name
        )}
      </h3>
    </div>
    <div class="employer-side-stack">
      {employment.data.status && (
        <span class="employment-status-badge">
          Status: {employment.data.status.label}{employment.data.status.emoji && ` ${employment.data.status.emoji}`}
        </span>
      )}
      {linkTitle && hasBody && (
        <a href={detailHref} class="more-info-link">
          <span class="info-icon">i</span>
          <span class="more-info-text">More about this employment</span>
        </a>
      )}
    </div>
  </div>

  {employment.data.locations && employment.data.locations.length > 0 && (
    <ul class="locations-list">
      {employment.data.locations.map((loc: string) => (
        <li><span class="loc-icon">📍</span><span class="loc-text">{loc}</span></li>
      ))}
    </ul>
  )}

  <p>{employment.data.summary}</p>

  <ul class="job-titles">
    {employment.data.jobTitles.map((job: { title: string; start: string; end?: string }) => (
      <li>
        <span class="job-title">{job.title}</span>
        <span class="job-dates">{job.start} – {job.end ?? 'Present'}</span>
      </li>
    ))}
  </ul>

  <p class="links-line">
    {employment.data.url && (
      <>🔗&nbsp;Employer's website: <a href={employment.data.url} target="_blank" rel="noopener noreferrer">{employment.data.url}</a></>
    )}
  </p>

  <fieldset class="tech-fieldset">
    <legend>Applied tech:</legend>
    {[...employment.data.tech].sort((a, b) => a.localeCompare(b)).map((t: string) => (
      <a href={`/tech/${slugify(t)}`} class="tech-badge" style={`--badge-color: ${resolveTechColor(t)}`}>
        {t}
      </a>
    ))}
  </fieldset>
</article>

<style>
  article {
    background: var(--color-bg-header);
    border-radius: 8px;
    padding: 1em 1.2em;
    margin-bottom: 1.2em;
  }
  .employer-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.4em 1em;
    margin-bottom: 0.2em;
  }
  .employer-title-line {
    flex: 1 1 200px;
    display: flex;
    align-items: center;
    gap: 0.5em;
  }
  .employer-title-line h3 {
    margin: 0;
  }
  .employer-side-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.3em;
  }
  .employer-header + p {
    margin-top: 0;
  }
  .employer-logo {
    width: 1.4em;
    height: 1.4em;
    object-fit: contain;
  }
  .more-info-link {
    grid-column: 2;
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.85em;
    white-space: nowrap;
  }
  .more-info-link:hover .more-info-text {
    text-decoration: underline;
  }
  .info-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.3em;
    height: 1.3em;
    border-radius: 50%;
    background: var(--color-dev);
    color: white;
    font-size: 0.8em;
    font-family: Georgia, serif;
  }
  :root[data-theme="dark"] .info-icon {
    color: #14181d;
  }
  .employment-status-badge {
    grid-column: 3;
    justify-self: end;
    position: relative;
    isolation: isolate;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    border-radius: 999px;
    color: #333;
    white-space: nowrap;
  }
  .employment-status-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: #D6E8F5;
    z-index: -1;
  }
  :root[data-theme="dark"] .employment-status-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .employment-status-badge {
    color: var(--color-bg);
  }
  .job-titles {
    list-style: none;
    margin: 0.3em 0;
    padding: 0;
  }
  .job-titles li {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    padding: 0.3em 0.6em;
    margin-bottom: 0.2em;
    border-radius: 4px;
    background: var(--color-bg);
  }
  .job-title {
    flex: 1;
  }
  .job-dates {
    flex-shrink: 0;
    color: var(--color-text);
    font-size: 0.9em;
    white-space: nowrap;
  }
  .links-line {
    line-height: 1.8;
  }
  .tech-badge {
    position: relative;
    display: inline-block;
    font-size: 0.8em;
    padding: 0.15em 0.6em;
    margin: 0.15em;
    border-radius: 999px;
    color: #333;
    text-decoration: none;
    isolation: isolate;
  }
  .tech-badge::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--badge-color);
    z-index: -1;
  }
  :root[data-theme="dark"] .tech-badge::before {
    filter: brightness(0.6) saturate(0.85);
  }
  :root[data-theme="dark"] .tech-badge {
    color: var(--color-bg);
  }
  .tech-fieldset {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.5em 0.8em;
    margin: 0.5em 0;
  }
  .tech-fieldset legend {
    padding: 0 0.4em;
    font-size: 0.85em;
    color: var(--color-text);
  }
  .tech-badge:hover {
    filter: brightness(0.95);
  }
  :root[data-theme="dark"] .tech-badge:hover {
    filter: brightness(1.15);
  }
  .locations-list {
    list-style: none;
    margin: 0 0 0.3em;
    padding: 0;
    font-size: 0.9em;
    color: var(--color-text);
  }
  .locations-list li {
    display: flex;
    gap: 0.4em;
  }
  .loc-icon {
    flex-shrink: 0;
  }
  .loc-text {
    flex: 1;
  }
</style>