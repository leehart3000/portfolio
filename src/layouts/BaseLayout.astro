---
import CookieConsent from '../components/CookieConsent.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
	title: string;
	description?: string;
}
const {
	title,
	description = 'Lee Hart’s software development: projects, technologies, employments, certificates.',
} = Astro.props;
const year = new Date().getFullYear();
const orcidUrl = 'https://orcid.org/0000-0002-6473-0964';
---

<html lang="en" style="height: 100%;">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <meta name="description" content={description} />
		<script is:inline>
			// Applied before paint to avoid a flash of the wrong theme.
			const saved = localStorage.getItem('theme');
			const theme = saved ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			document.documentElement.setAttribute('data-theme', theme);
		</script>
	</head>
	<body>
		<CookieConsent />

		<header class="site-header">
			<a href="/" class="brand">
				<img src="/logo.svg" alt="" width="40" height="40" class="logo-img" />
				<span class="wordmark">
					<span class="hart">Hart</span><span class="soft">Soft</span><span class="dot">.</span><span class="dev">Dev</span>
				</span>
			</a>
      <nav class="site-nav">
        <a href="/projects"><span class="nav-icon">📁&nbsp;</span>Projects</a>
        <a href="/tech"><span class="nav-icon">🛠️&nbsp;</span>Technologies</a>
        <a href="/employments"><span class="nav-icon">💼&nbsp;</span>Employments</a>
        <a href="/certificates"><span class="nav-icon">📜&nbsp;</span>Certificates</a>
        <a href="/contact"><span class="nav-icon">✉️&nbsp;</span>Contact</a>
				<button id="theme-toggle" aria-label="Toggle dark mode">
					<span id="theme-toggle-icon">🌙</span> <span id="theme-toggle-label">Dark</span>
				</button>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<span class="footer-meta">
				<span class="copyright">©&nbsp;{year}&nbsp;Lee&nbsp;Hart</span>
				<span class="footer-sep" aria-hidden="true">·</span>
				<a href="/privacy">Privacy&nbsp;Policy</a>
				<span class="footer-sep" aria-hidden="true">·</span>
				<a href={orcidUrl} class="orcid-link" target="_blank" rel="me noopener noreferrer" title="ORCID iD: 0000-0002-6473-0964" aria-label="Lee Hart's ORCID record (opens in a new tab)">
					<svg class="orcid-icon" viewBox="0 0 256 256" aria-hidden="true" focusable="false">
						<path fill="#A6CE39" d="M256,128c0,70.7-57.3,128-128,128C57.3,256,0,198.7,0,128C0,57.3,57.3,0,128,0C198.7,0,256,57.3,256,128z"/>
						<path fill="#FFFFFF" d="M86.3,186.2H70.9V79.1h15.4v48.4V186.2z"/>
						<path fill="#FFFFFF" d="M108.9,79.1h41.6c39.6,0,57,28.3,57,53.6c0,27.5-21.5,53.6-56.8,53.6h-41.8V79.1z M124.3,172.4h24.5c34.9,0,42.9-26.5,42.9-39.7c0-21.5-13.7-39.7-43.7-39.7h-23.7V172.4z"/>
						<path fill="#FFFFFF" d="M88.7,56.8c0,5.5-4.5,10.1-10.1,10.1c-5.6,0-10.1-4.6-10.1-10.1c0-5.6,4.5-10.1,10.1-10.1C84.2,46.7,88.7,51.3,88.7,56.8z"/>
					</svg>
				</a>
			</span>
      <nav class="site-nav">
        <a href="/projects"><span class="nav-icon">📁&nbsp;</span>Projects</a>
        <a href="/tech"><span class="nav-icon">🛠️&nbsp;</span>Technologies</a>
        <a href="/employments"><span class="nav-icon">💼&nbsp;</span>Employments</a>
        <a href="/certificates"><span class="nav-icon">📜&nbsp;</span>Certificates</a>
        <a href="/contact"><span class="nav-icon">✉️&nbsp;</span>Contact</a>
			</nav>
		</footer>

		<script is:inline>
			function updateToggleLabel(theme) {
				const icon = document.getElementById('theme-toggle-icon');
				const label = document.getElementById('theme-toggle-label');
				if (theme === 'dark') {
					icon.textContent = '☀️';
					label.textContent = 'Light';
				} else {
					icon.textContent = '🌙';
					label.textContent = 'Dark';
				}
			}

			updateToggleLabel(document.documentElement.getAttribute('data-theme'));

			document.getElementById('theme-toggle').addEventListener('click', () => {
				const current = document.documentElement.getAttribute('data-theme');
				const next = current === 'dark' ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', next);
				localStorage.setItem('theme', next);
				updateToggleLabel(next);
			});
		</script>
    <Lightbox />
	</body>
  <style is:global>
    :root {
      --color-bg: #ffffff;
      --color-bg-header: #f4f4f5;
      --color-text: #4a4a4a;
      --color-hart: #7A1F2B;
      --color-soft: #2E5C3A;
      --color-dev: #0F3D6B;
      --color-dot: #000000;
      --color-border: #ddd;
      --color-heading: #4d4d4d;
      --color-image-border: #333333;
      --color-code-bg: #eceef1;
      --color-code-text: #7A1F2B;
    }
    :root[data-theme="dark"] {
      --color-bg: #14181d;
      --color-bg-header: #1c2128;
      --color-text: #a3a3a3;
      --color-hart: #d97878;
      --color-soft: #7ec98f;
      --color-dev: #7aa8d6;
      --color-dot: #ffffff;
      --color-border: #333;
      --color-heading: #cfcfcf;
      --color-image-border: #cccccc;
      --color-code-bg: #262c35;
      --color-code-text: #e0a3a3;
    }
    * {
      box-sizing: border-box;
    }
    html, body {
      height: 100%;
    }
    body {
      margin: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--color-bg);
      color: var(--color-text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      font-size: 16px;
      line-height: 1.7;
    }
    main {
      flex: 1 0 auto;
      max-width: 900px;
      margin: 0 auto;
      width: 100%;
      padding: 0.75em 1.25em 2em;
    }
    main > :first-child {
      margin-top: 0;
    }
    a {
      color: var(--color-hart);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    :root[data-theme="dark"] a {
      color: var(--color-dev);
    }
    h1, h2, h3 {
      color: var(--color-heading);
    }
    h1 {
      margin-bottom: 0.4em;
    }
    :not(pre) > code {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.88em;
      padding: 0.1em 0.35em;
      border-radius: 4px;
      background: var(--color-code-bg);
      color: var(--color-code-text);
    }
  </style>
  <style>
    .site-header,
    .site-footer {
      display: flex;
      justify-content: space-between;
      background: var(--color-bg-header);
      padding: 0.8em 1.25em;
      flex-wrap: wrap;
      gap: 0.6em;
      flex-shrink: 0;
    }
    .site-header {
      align-items: baseline;
      border-bottom: 1px solid var(--color-border);
    }
    .site-footer {
      align-items: baseline;
      border-top: 1px solid var(--color-border);
      font-size: 0.9em;
    }
    .logo-img {
      position: relative;
      top: 0.35em;
    }
    .brand {
      display: flex;
      align-items: baseline;
      gap: 0.5em;
      text-decoration: none;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .brand:hover .wordmark {
      text-decoration: underline;
      text-decoration-color: var(--color-hart);
    }
    :root[data-theme="dark"] .brand:hover .wordmark {
      text-decoration-color: var(--color-dev);
    }
    .hart {
      color: var(--color-hart);
    }
    .soft {
      color: var(--color-soft);
    }
    .dot {
      color: var(--color-dot);
      margin: 0;
    }
    .dev {
      color: var(--color-dev);
    }
    .site-nav {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 1.2em;
    }
    .site-nav a {
      color: var(--color-hart);
      text-decoration: none;
    }
    :root[data-theme="dark"] .site-nav a {
      color: var(--color-dev);
    }
    .site-nav a:hover {
      text-decoration: underline;
    }
    #theme-toggle {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      color: var(--color-hart);
      white-space: nowrap;
    }
    :root[data-theme="dark"] #theme-toggle {
      color: var(--color-dev);
    }
    #theme-toggle:hover #theme-toggle-label {
      text-decoration: underline;
    }
    .copyright {
      color: var(--color-text);
    }
    .brand {
      font-size: 1.4rem;
    }
    .site-header .site-nav a,
    #theme-toggle {
      font-size: 0.85rem;
    }
    .site-footer .site-nav a,
    .footer-meta {
      font-size: 0.72rem;
    }
    /* Copyright · ORCID · Privacy: each part stays on one line, but the
       parts can wrap onto a new line on narrow screens. */
    .footer-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 0.45em;
      color: var(--color-text);
    }
    .footer-meta > * {
      white-space: nowrap;
    }
    .orcid-link {
      display: inline-flex;
      align-items: center;
      line-height: 1;
    }
    .orcid-link:hover {
      text-decoration: none;
      filter: brightness(0.9);
    }
    .orcid-icon {
      display: block;
      width: 1.35em;
      height: 1.35em;
    }
    .nav-icon {
      text-decoration: none;
      display: inline-block;
    }
    .site-nav a:hover .nav-icon {
      text-decoration: none;
    }
    .site-nav a,
    .copyright {
      white-space: nowrap;
    }
    @media (max-width: 480px) {
      .site-header,
      .site-footer {
        flex-direction: column;
        align-items: flex-start;
      }
      .site-nav {
        gap: 0.8em;
      }
    }
  </style>
</html>