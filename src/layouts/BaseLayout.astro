---
import CookieConsent from '../components/CookieConsent.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
	title: string;
}
const { title } = Astro.props;
const year = new Date().getFullYear();
---

<html lang="en" style="height: 100%;">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script is:inline>
			// Applied before paint to avoid a flash of the wrong theme.
			const saved = localStorage.getItem('theme');
			const theme = saved ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			document.documentElement.setAttribute('data-theme', theme);
		</script>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand">
				<img src="/logo.svg" alt="" width="40" height="40" class="logo-img" />
				<span class="wordmark">
					<span class="hart">Hart</span><span class="soft">Soft</span><span class="dot">.</span><span class="dev">Dev</span>
				</span>
			</a>
      <nav class="site-nav">
        <a href="/projects"><span class="nav-icon">📁&nbsp;</span>Projects</a>
        <a href="/tech"><span class="nav-icon">🛠️&nbsp;</span>Known&nbsp;Tech</a>
        <a href="/employments"><span class="nav-icon">💼&nbsp;</span>Employments</a>
        <a href="/certificates"><span class="nav-icon">📚&nbsp;</span>Certificates</a>
        <a href="/contact"><span class="nav-icon">✉️&nbsp;</span>Contact</a>
				<button id="theme-toggle" aria-label="Toggle dark mode">
					<span id="theme-toggle-icon">🌙</span> <span id="theme-toggle-label">Dark</span>
				</button>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<span class="copyright">©&nbsp;{year}&nbsp;Lee&nbsp;Hart&nbsp;·&nbsp;<a href="/privacy">Privacy</a></span>
      <nav class="site-nav">
        <a href="/projects"><span class="nav-icon">📁&nbsp;</span>Projects</a>
        <a href="/tech"><span class="nav-icon">🛠️&nbsp;</span>Known&nbsp;Tech</a>
        <a href="/employments"><span class="nav-icon">💼&nbsp;</span>Employments</a>
        <a href="/certificates"><span class="nav-icon">📚&nbsp;</span>Certificates</a>
        <a href="/contact"><span class="nav-icon">✉️&nbsp;</span>Contact</a>
			</nav>
		</footer>

		<script is:inline>
			function updateToggleLabel(theme) {
				const icon = document.getElementById('theme-toggle-icon');
				const label = document.getElementById('theme-toggle-label');
				if (theme === 'dark') {
					icon.textContent = '☀️';
					label.textContent = 'Light';
				} else {
					icon.textContent = '🌙';
					label.textContent = 'Dark';
				}
			}

			updateToggleLabel(document.documentElement.getAttribute('data-theme'));

			document.getElementById('theme-toggle').addEventListener('click', () => {
				const current = document.documentElement.getAttribute('data-theme');
				const next = current === 'dark' ? 'light' : 'dark';
				document.documentElement.setAttribute('data-theme', next);
				localStorage.setItem('theme', next);
				updateToggleLabel(next);
			});
		</script>
    <Lightbox />
    <CookieConsent />
	</body>
  <style is:global>
    :root {
      --color-bg: #ffffff;
      --color-bg-header: #f4f4f5;
      --color-text: #4a4a4a;
      --color-hart: #7A1F2B;
      --color-soft: #2E5C3A;
      --color-dev: #0F3D6B;
      --color-dot: #000000;
      --color-border: #ddd;
      --color-heading: #4d4d4d;
      --color-image-border: #333333;
      --cookie-banner-offset: 0px;
    }
    :root[data-theme="dark"] {
      --color-bg: #14181d;
      --color-bg-header: #1c2128;
      --color-text: #a3a3a3;
      --color-hart: #d97878;
      --color-soft: #7ec98f;
      --color-dev: #7aa8d6;
      --color-dot: #ffffff;
      --color-border: #333;
      --color-heading: #cfcfcf;
      --color-image-border: #cccccc;
    }
    * {
      box-sizing: border-box;
    }
    html, body {
      height: 100%;
    }
    body {
      margin: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: var(--color-bg);
      color: var(--color-text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      font-size: 16px;
      line-height: 1.7;
    }
    body {
      padding-bottom: var(--cookie-banner-offset, 0px);
    }
    main {
      flex: 1 0 auto;
      max-width: 900px;
      margin: 0 auto;
      width: 100%;
      padding: 0.75em 1.25em 2em;
    }
    main > :first-child {
      margin-top: 0;
    }
    a {
      color: var(--color-hart);
      text-decoration: none;
    }
    a:hover {
      text-decoration: underline;
    }
    :root[data-theme="dark"] a {
      color: var(--color-dev);
    }
    h1, h2, h3 {
      color: var(--color-heading);
    }
    h1 {
      margin-bottom: 0.4em;
    }
  </style>
  <style>
    .site-header,
    .site-footer {
      display: flex;
      justify-content: space-between;
      background: var(--color-bg-header);
      padding: 0.8em 1.25em;
      flex-wrap: wrap;
      gap: 0.6em;
      flex-shrink: 0;
    }
    .site-header {
      align-items: baseline;
      border-bottom: 1px solid var(--color-border);
    }
    .site-footer {
      align-items: baseline;
      border-top: 1px solid var(--color-border);
      font-size: 0.9em;
    }
    .logo-img {
      position: relative;
      top: 0.35em;
    }
    .brand {
      display: flex;
      align-items: baseline;
      gap: 0.5em;
      text-decoration: none;
      font-weight: 600;
      letter-spacing: -0.01em;
    }
    .brand:hover .wordmark {
      text-decoration: underline;
      text-decoration-color: var(--color-hart);
    }
    :root[data-theme="dark"] .brand:hover .wordmark {
      text-decoration-color: var(--color-dev);
    }
    .hart {
      color: var(--color-hart);
    }
    .soft {
      color: var(--color-soft);
    }
    .dot {
      color: var(--color-dot);
      margin: 0;
    }
    .dev {
      color: var(--color-dev);
    }
    .site-nav {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 1.2em;
    }
    .site-nav a {
      color: var(--color-hart);
      text-decoration: none;
    }
    :root[data-theme="dark"] .site-nav a {
      color: var(--color-dev);
    }
    .site-nav a:hover {
      text-decoration: underline;
    }
    #theme-toggle {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      color: var(--color-hart);
      white-space: nowrap;
    }
    :root[data-theme="dark"] #theme-toggle {
      color: var(--color-dev);
    }
    #theme-toggle:hover #theme-toggle-label {
      text-decoration: underline;
    }
    .copyright {
      color: var(--color-text);
    }
    .brand {
      font-size: 1.4rem;
    }
    .site-header .site-nav a,
    #theme-toggle {
      font-size: 0.85rem;
    }
    .site-footer .site-nav a,
    .copyright {
      font-size: 0.72rem;
    }
    .nav-icon {
      text-decoration: none;
      display: inline-block;
    }
    .site-nav a:hover .nav-icon {
      text-decoration: none;
    }
    .site-nav a,
    .copyright {
      white-space: nowrap;
    }
    @media (max-width: 480px) {
      .site-header,
      .site-footer {
        flex-direction: column;
        align-items: flex-start;
      }
      .site-nav {
        gap: 0.8em;
      }
    }
  </style>
</html>